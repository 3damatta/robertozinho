sudo bash -c 'cat > /opt/icerobot/kiosk.sh << EOL
#!/bin/bash
echo "=== Script Kiosk iniciado em: \$(date) ===" >> /tmp/kiosk.log
sleep 7
echo "Disparando o Chromium..." >> /tmp/kiosk.log
chromium-browser --kiosk --noerrdialogs --disable-infobars --no-first-run http://localhost:8080 >> /tmp/kiosk.log 2>&1
echo "Chromium finalizado com código: \$?" >> /tmp/kiosk.log
EOL'
sudo chmod +x /opt/icerobot/kiosk.sh
