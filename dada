# 1. Sobrescreve as configurações do PM2 para forçar o perfil de produção (prod)
cat << 'EOF' | sudo tee /opt/icerobot/ecosystem.config.js
module.exports = {
  apps : [{
    name: "icerobot-app",
    script: "java",
    args: "-Dspring.profiles.active=prod -jar backend/target/server.jar",
    cwd: "/opt/icerobot",
    watch: false,
    env: {
      NODE_ENV: "production",
      SPRING_PROFILES_ACTIVE: "prod"
    }
  }]
}
EOF

# 2. Deleta o processo antigo do gerenciador para limpar o cache dele
sudo pm2 delete icerobot-app

# 3. Inicia o aplicativo novamente usando a nova configuração
sudo pm2 start /opt/icerobot/ecosystem.config.js

# 4. Salva as configurações para ligar junto com o Raspberry Pi
sudo pm2 save
