# 1. Ajusta o delay do kiosk para abrir instantaneamente (0.1 segundos)
sudo sed -i 's/sleep [0-9]/sleep 0.1/g' /opt/icerobot/kiosk.sh

# 2. Detecta o arquivo de boot correto
if [ -f /boot/firmware/cmdline.txt ]; then
    CMDLINE="/boot/firmware/cmdline.txt"
else
    CMDLINE="/boot/cmdline.txt"
fi

# 3. Restaura o backup anterior para garantir um estado limpo
if [ -f "${CMDLINE}.bak" ]; then
    sudo cp "${CMDLINE}.bak" "$CMDLINE"
fi

# 4. Remove quiet, splash e configurações antigas
CONTENT=$(cat "$CMDLINE" | sed -e 's/ quiet//g' -e 's/ splash//g' -e 's/ loglevel=[0-9]//g' -e 's/ logo.nologo//g' -e 's/ vt.global_cursor_default=[0-9]//g' -e 's/ consoleblank=[0-9]//g' -e 's/ plymouth.enable=[0-9]//g')

# 5. Aplica a inicialização 100% silenciosa com tela preta e desativa o Plymouth logo
echo "$CONTENT quiet loglevel=3 logo.nologo vt.global_cursor_default=0 consoleblank=1 plymouth.enable=0" | sudo tee "$CMDLINE" > /dev/null

echo "Pronto! Pode reiniciar agora com 'sudo reboot' para testar."
